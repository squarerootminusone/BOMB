{
  "name": "go_single_move_mimicgen",
  "description": "Single-move DeepMind Go task for MimicGen augmentation",
  "task_spec": {
    "subtask_1": {
      "object_ref": "target_intersection",
      "subtask_term_signal": "reach_target",
      "subtask_term_offset_range": [1, 4],
      "selection_strategy": "nearest_neighbor_object",
      "selection_strategy_kwargs": {
        "nn_k": 3
      },
      "action_noise": 0.03,
      "num_interpolation_steps": 6,
      "num_fixed_steps": 1,
      "apply_noise_during_interpolation": false
    },
    "subtask_2": {
      "object_ref": "target_intersection",
      "subtask_term_signal": null,
      "subtask_term_offset_range": [0, 0],
      "selection_strategy": "nearest_neighbor_object",
      "selection_strategy_kwargs": {
        "nn_k": 3
      },
      "action_noise": 0.05,
      "num_interpolation_steps": 4,
      "num_fixed_steps": 1,
      "apply_noise_during_interpolation": true
    }
  },
  "defaults": {
    "num_demos": 200,
    "max_attempts": 500,
    "select_src_per_subtask": false,
    "transform_first_robot_pose": true,
    "interpolate_from_last_target_pose": true,
    "seed": 0,
    "opening_moves_min": 0,
    "opening_moves_max": 10
  }
}
